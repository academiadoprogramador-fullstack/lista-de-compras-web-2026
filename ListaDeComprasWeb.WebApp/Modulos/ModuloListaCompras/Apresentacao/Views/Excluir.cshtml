@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Lista de Compras";
}

@model ExcluirListaComprasViewModel;

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" asp-action="Excluir" asp-route-id="@Model.Id" method="post">
    <input asp-for="Id" type="hidden">

    <div class="alert alert-primary border-start border-primary border-4 rounded-3" role="alert">
        Deseja realmente excluir esta lista de compras?
    </div>

    @if (Model.TotalItens > 0)
    {
        <div class="alert alert-warning border-start border-warning border-4 rounded-3" role="alert">
            Os itens cadastrados nesta lista também serão excluídos.
        </div>
    }

    <dl class="row mb-0">
        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">ID</dt>
        <dd class="col-sm-8 text-break">@Model.Id</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Nome</dt>
        <dd class="col-sm-8">@Model.Nome</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Criada em</dt>
        <dd class="col-sm-8">@Model.DataCriacao.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Itens</dt>
        <dd class="col-sm-8">@Model.TotalItens</dd>

        <dt class="col-sm-4 fw-semibold text-primary text-uppercase small">Total Estimado</dt>
        <dd class="col-sm-8">@Model.TotalEstimado.ToString("C")</dd>
    </dl>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">Voltar</a>
        <button class="btn btn-primary rounded-pill px-4" type="submit">Confirmar</button>
    </div>
</form>
